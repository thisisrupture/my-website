---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="The Focused Acceleration Model — Rupture"
  description="Rupture's framework for building a real edge with AI: a clear order for building an AI capability, and a way to check whether work already underway is being built on the right foundations."
>
  <div class="wrap">
    <Header active="model" />

    <main class="fam-page">
      <div class="fam-root">

        <section class="fam-head">
          <div class="fam-eyebrow"><span class="fam-eyebrow-dot" aria-hidden="true"></span>The framework</div>
          <h1 class="fam-title">The Focused Acceleration Model<sup>&trade;</sup><span class="fam-stop">.</span></h1>
          <p class="fam-lede">
            This isn&rsquo;t about doing AI. It&rsquo;s about designing competitive advantage and using AI to
            reach it faster. Our model helps you adopt AI with the discipline, foresight and visibility
            that investors and boards can take confidence in.
          </p>
        </section>

        <!-- ===== INTERACTIVE FIGURE ===== -->
        <figure class="fam-figure">
          <div class="fam-stage">
            <svg class="fam-svg" id="famSvg" viewBox="0 0 1120 630" role="group"
                 aria-label="The Focused Acceleration Model: five stages climbing from a converged-market baseline to competitive daylight."
                 data-selection="false">

              <!-- Baseline -->
              <line class="fam-baseline" x1="60" y1="540" x2="1060" y2="540"></line>
              <text class="fam-axis-label" x="60" y="596">THE CONVERGED MARKET &mdash; EVERYONE OPTIMISING THE SAME WAY</text>

              <!-- Climbing line -->
              <path class="fam-climb" id="famClimb"></path>
              <polygon class="fam-arrowhead" id="famArrow"></polygon>

              <!-- Iterate loop between stage 04 and 05 -->
              <g id="famLoop" aria-hidden="true">
                <path class="fam-loop-path" id="famLoopPath"></path>
                <polygon class="fam-loop-arrow" id="famLoopArrow"></polygon>
                <text class="fam-loop-text" id="famLoopText1"></text>
                <text class="fam-loop-text" id="famLoopText2"></text>
              </g>

              <!-- Daylight drop near stage 05 -->
              <g id="famDaylight" aria-hidden="true">
                <line class="fam-daylight-line" id="famDaylightLine"></line>
                <text class="fam-daylight-text" id="famDaylightText">DAYLIGHT</text>
              </g>

              <!-- Nodes injected by JS -->
              <g id="famNodes"></g>
            </svg>
          </div>

          <!-- Detail panel -->
          <div class="fam-panel" id="famPanel" data-accent="false" data-coral="false" aria-live="polite">
            <div class="fam-panel-num" id="famPanelNum">01</div>
            <div class="fam-panel-body">
              <h2 class="fam-panel-name" id="famPanelName">Define the destination</h2>
              <p class="fam-panel-desc" id="famPanelDesc"></p>
            </div>
            <div class="fam-panel-ctrl">
              <span class="fam-panel-pos" id="famPanelPos">01 / 05</span>
              <div class="fam-panel-nav">
                <button type="button" class="fam-nav-btn" id="famPrev" aria-label="Previous stage">&larr;</button>
                <button type="button" class="fam-nav-btn" id="famNext" aria-label="Next stage">&rarr;</button>
              </div>
            </div>
          </div>

          <figcaption class="fam-figcap">
            The Focused Acceleration Model gives a clear order for building an AI capability, and a way to
            check whether work already underway is being built on the right foundations.
          </figcaption>
        </figure>

        <p class="fam-colophon">Focused Acceleration Model&trade; &nbsp;&middot;&nbsp; &copy; Rupture &mdash; This Is Rupture Ltd</p>

      </div>
    </main>

    <Contact heading="Build the edge first. Then accelerate." />
    <Footer />
  </div>
</Base>

<style is:global>
  /* ------------------------------------------------------------------
     The Focused Acceleration Model — interactive figure.
     Themed entirely with Rupture design tokens (tokens.css), so it
     inherits the site's paper, ink, mint, coral and type automatically.
     All selectors are scoped under .fam-root to avoid leaking.
     ------------------------------------------------------------------ */

  .fam-page { min-width: 0; }
  .fam-root { padding: clamp(20px, 4vw, 40px) 0 0; }

  /* ---- Header block ---- */
  .fam-root .fam-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--fg-muted);
    display: flex; align-items: center; gap: 10px;
    margin: 0 0 22px;
  }
  .fam-root .fam-eyebrow-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--coral); display: inline-block; }

  .fam-root .fam-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(2.2rem, 5.4vw, 4rem);
    line-height: 1.0; letter-spacing: -0.02em;
    margin: 0 0 22px; max-width: 18ch;
  }
  .fam-root .fam-title sup { font-size: 0.34em; top: -1em; font-weight: 400; }
  .fam-root .fam-title .fam-stop { color: var(--coral); }

  .fam-root .fam-lede {
    font-family: var(--font-serif); font-weight: 400;
    font-size: clamp(1.15rem, 1.8vw, 1.5rem); line-height: 1.4;
    max-width: 44ch; margin: 0 0 clamp(30px, 5vw, 52px);
  }

  /* ---- Figure frame ---- */
  .fam-root .fam-figure { margin: 0; border: var(--hairline); background: var(--paper); }
  .fam-root .fam-stage { padding: clamp(20px, 3vw, 40px) clamp(16px, 3vw, 40px) 8px; }
  .fam-root .fam-svg { width: 100%; height: auto; display: block; overflow: visible; }

  .fam-root .fam-svg text { fill: var(--ink); }
  .fam-root .fam-axis-label {
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.14em;
    fill: var(--fg-muted); text-transform: uppercase;
  }

  /* Climbing line */
  .fam-root .fam-climb { fill: none; stroke: var(--ink); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .fam-root .fam-arrowhead { fill: var(--coral); }

  /* Baseline */
  .fam-root .fam-baseline { stroke: var(--fg-faint); stroke-width: 1.5; }

  /* Daylight drop */
  .fam-root .fam-daylight-line { stroke: var(--mint-ink); stroke-width: 1.5; stroke-dasharray: 5 5; }
  .fam-root .fam-daylight-arrow { fill: var(--mint-ink); }
  .fam-root .fam-daylight-text {
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.16em;
    fill: var(--mint-ink); text-transform: uppercase;
  }

  /* Iterate loop */
  .fam-root .fam-loop-path { fill: none; stroke: var(--fg-muted); stroke-width: 1.4; }
  .fam-root .fam-loop-arrow { fill: var(--fg-muted); }
  .fam-root .fam-loop-text { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.09em; fill: var(--fg-muted); }

  /* Nodes */
  .fam-root .fam-node { cursor: pointer; outline: none; }
  .fam-root .fam-node-dot {
    fill: var(--paper); stroke: var(--ink); stroke-width: 2.5;
    transition: fill 0.2s var(--ease, ease), stroke 0.2s var(--ease, ease), r 0.2s var(--ease, ease);
  }
  .fam-root .fam-node[data-accent="true"] .fam-node-dot { fill: var(--mint); stroke: var(--mint); }
  .fam-root .fam-node[data-coral="true"]  .fam-node-dot { fill: var(--coral); stroke: var(--coral); }

  .fam-root .fam-node-num {
    font-family: var(--font-mono); font-size: 16px; font-weight: 600; letter-spacing: 0.02em;
    fill: var(--ink); transition: fill 0.2s var(--ease, ease);
  }
  .fam-root .fam-node[data-accent="true"] .fam-node-num { fill: var(--ink); }
  .fam-root .fam-node[data-coral="true"]  .fam-node-num { fill: var(--paper); }

  .fam-root .fam-node-name {
    font-family: var(--font-sans); font-size: 14px; font-weight: 600;
    fill: var(--ink); transition: fill 0.2s var(--ease, ease), opacity 0.2s var(--ease, ease);
  }

  /* Hover / focus */
  .fam-root .fam-node:hover .fam-node-dot,
  .fam-root .fam-node:focus-visible .fam-node-dot { r: 27; }
  .fam-root .fam-node:focus-visible .fam-node-dot { stroke: var(--mint-ink); }

  /* Active (selected) */
  .fam-root .fam-node[data-active="true"] .fam-node-dot { fill: var(--ink); stroke: var(--ink); }
  .fam-root .fam-node[data-active="true"][data-accent="true"] .fam-node-dot { fill: var(--mint-ink); stroke: var(--mint-ink); }
  .fam-root .fam-node[data-active="true"][data-coral="true"]  .fam-node-dot { fill: var(--coral-ink); stroke: var(--coral-ink); }
  .fam-root .fam-node[data-active="true"] .fam-node-num { fill: var(--paper); }
  .fam-root .fam-node[data-active="true"][data-accent="true"] .fam-node-num { fill: var(--paper); }

  /* Dimming when a node is selected */
  .fam-root .fam-svg[data-selection="true"] .fam-node[data-active="false"] { opacity: 0.34; }
  .fam-root .fam-svg[data-selection="true"] .fam-node[data-active="false"] .fam-node-name { opacity: 0.5; }

  /* ---- Detail panel ---- */
  .fam-root .fam-panel {
    margin: 0; border-top: var(--hairline);
    padding: 24px clamp(16px, 3vw, 30px);
    min-height: 172px;
    display: grid; grid-template-columns: auto 1fr auto; gap: 20px 24px; align-items: start;
  }
  .fam-root .fam-panel-num {
    font-family: var(--font-mono); font-size: clamp(30px, 5vw, 44px); font-weight: 600;
    color: var(--fg-faint); line-height: 1;
  }
  .fam-root .fam-panel[data-accent="true"] .fam-panel-num { color: var(--mint-ink); }
  .fam-root .fam-panel[data-coral="true"]  .fam-panel-num { color: var(--coral); }
  .fam-root .fam-panel-name {
    font-family: var(--font-sans); font-weight: 700; font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    line-height: 1.15; margin: 0 0 10px;
  }
  .fam-root .fam-panel-desc { font-size: clamp(1rem, 1.6vw, 1.05rem); line-height: 1.55; max-width: 66ch; margin: 0; }
  .fam-root .fam-panel-ctrl {
    display: flex; flex-direction: column; align-items: flex-end; gap: 12px; justify-self: end;
  }
  .fam-root .fam-panel-pos {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; color: var(--fg-muted);
  }
  .fam-root .fam-panel-nav { display: flex; gap: 8px; }
  .fam-root .fam-nav-btn {
    width: 44px; height: 44px; border: 1.5px solid var(--ink); border-radius: 6px;
    background: var(--paper); cursor: pointer; font-family: var(--font-mono); font-size: 15px;
    color: var(--ink); transition: background 0.15s var(--ease), opacity 0.2s var(--ease);
  }
  .fam-root .fam-nav-btn:hover { background: var(--paper-2); }
  .fam-root .fam-nav-btn:disabled { opacity: 0.32; cursor: default; }
  .fam-root .fam-colophon {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; color: var(--fg-muted);
    margin: 24px 0 0;
  }

  /* ---- Figcaption ---- */
  .fam-root .fam-figcap {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--fg-muted); background: var(--paper);
    border-top: var(--hairline-faint); padding: 12px 14px; line-height: 1.5;
  }

  /* ---- Responsive ---- */
  @media (max-width: 720px) {
    .fam-root .fam-node-name { font-size: 17px; }
    .fam-root .fam-axis-label { font-size: 15px; }
    .fam-root .fam-daylight-text { font-size: 15px; }
    .fam-root .fam-loop-text { font-size: 13px; }
    .fam-root .fam-panel { grid-template-columns: 1fr; }
    .fam-root .fam-panel-ctrl { align-items: flex-start; justify-self: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fam-root .fam-climb, .fam-root .fam-node-dot, .fam-root .fam-node-name, .fam-root .fam-node-num { transition: none !important; }
  }
</style>

<script>
  // The Focused Acceleration Model — figure logic.
  // Pure attribute toggling; all colour lives in CSS tokens above.
  const STAGES = [
    { num: "01", line: ["Define the", "destination"], name: "Define the destination",
      desc: "Leadership begins by defining what the organisation intends to become—not as a vision exercise, but as the strategic ambition that shapes every decision that follows. What company are you trying to build that doesn't exist today? The destination does not determine the competitive advantage, but it defines the space in which that advantage must be found and provides the reference point for every subsequent decision. It also provides a basis for assessing whether existing initiatives are aligned to a common strategic direction.",
      accent: false, coral: false },
    { num: "02", line: ["Name the", "frame"], name: "Name the frame",
      desc: "Every market operates within a set of accepted beliefs, assumptions and perceived constraints. Before deciding how to compete differently, those assumptions are made explicit—starting with the organisation's own thinking—to identify the underlying market assumptions through which enduring competitive advantage can be created or strengthened. It also provides a basis for assessing whether existing decisions are reinforcing the current market frame or challenging it.",
      accent: false, coral: false },
    { num: "03", line: ["Design the", "advantage"], name: "Design the advantage",
      desc: "Not every assumption is worth challenging. Potential opportunities are assessed for strategic leverage, commercial impact, defensibility and organisational fit before a clearly defined domain of competitive advantage is selected. It also provides a basis for assessing whether existing initiatives are strengthening the chosen domain of advantage or dispersing investment across competing priorities.",
      accent: true, coral: false },
    { num: "04", line: ["Build the", "capability"], name: "Build the capability",
      desc: "The capabilities, operating model, governance, technology and organisational changes required to deliver the chosen domain of competitive advantage are defined and sequenced into a practical transformation roadmap. It also provides a basis for assessing whether current investments are building the capabilities required to sustain that position or responding primarily to short-term priorities.",
      accent: false, coral: false },
    { num: "05", line: ["Accelerate the", "advantage"], name: "Accelerate the advantage",
      desc: "AI is applied to strengthen the capabilities that underpin the chosen domain of competitive advantage, increasing the organisation's ability to outperform competitors over time. Performance is continuously measured to validate progress, refine implementation and strengthen competitive separation. It also provides a basis for assessing whether existing AI investments are creating measurable strategic advantage or delivering operational improvement alone.",
      accent: false, coral: true }
  ];

  const NS = "http://www.w3.org/2000/svg";
  const BASE_Y = 540;
  const X = [150, 360, 565, 770, 955];
  const Y = [540, 480, 390, 275, 140];
  const CLIMB_D = "M 150 540 C 220 540 290.8 505 360 480 C 429.2 455 496.7 424.2 565 390 C 633.3 355.8 705 316.7 770 275 C 835 233.3 910 174.5 955 140 C 1000 105.5 1020 84 1032 74";
  const ARROW_POINTS = "1040,68 1032.6,84 1023,72.6";

  const svg    = document.getElementById("famSvg");
  const nodesG = document.getElementById("famNodes");
  const climb  = document.getElementById("famClimb") as unknown as SVGPathElement;
  const arrow  = document.getElementById("famArrow");

  if (svg && nodesG && climb && arrow) {

    // Climbing curve (accelerating)
    climb.setAttribute("d", CLIMB_D);
    arrow.setAttribute("points", ARROW_POINTS);

    // Performance feedback loop — leaves the curve just after stage 05 and reconnects just before it
    (function () {
      const loop = document.getElementById("famLoopPath");
      loop?.setAttribute("d", "M 972 127 A 45 45 0 1 1 938 153");
      const la = document.getElementById("famLoopArrow");
      la?.setAttribute("points", "938,153 939.1,165.5 928.1,160.7");
      const t1 = document.getElementById("famLoopText1");
      t1?.setAttribute("x", "979"); t1?.setAttribute("y", "245"); t1?.setAttribute("text-anchor", "middle");
      if (t1) t1.textContent = "PERFORMANCE";
      const t2 = document.getElementById("famLoopText2");
      t2?.setAttribute("x", "979"); t2?.setAttribute("y", "261"); t2?.setAttribute("text-anchor", "middle");
      if (t2) t2.textContent = "FEEDBACK";
    })();

    // Daylight drop
    (function () {
      const dx = 1058;
      const line = document.getElementById("famDaylightLine");
      line?.setAttribute("x1", String(dx)); line?.setAttribute("y1", "102");
      line?.setAttribute("x2", String(dx)); line?.setAttribute("y2", String(BASE_Y));
      const g = document.getElementById("famDaylight");
      const head = document.createElementNS(NS, "polygon");
      head.setAttribute("class", "fam-daylight-arrow");
      head.setAttribute("points", (dx) + ",88 " + (dx - 5.5) + ",102 " + (dx + 5.5) + ",102");
      g?.insertBefore(head, g.firstChild);
      const txt = document.getElementById("famDaylightText");
      txt?.setAttribute("x", "1066");
      txt?.setAttribute("y", "318");
      txt?.setAttribute("transform", "rotate(90 1066 318)");
      txt?.setAttribute("text-anchor", "middle");
    })();

    // Build nodes
    const nodeEls: SVGGElement[] = [];
    STAGES.forEach((s, i) => {
      const g = document.createElementNS(NS, "g");
      g.setAttribute("class", "fam-node");
      g.setAttribute("tabindex", "0");
      g.setAttribute("role", "button");
      g.setAttribute("aria-label", "Stage " + s.num + ": " + s.name + ".");
      g.setAttribute("data-accent", s.accent ? "true" : "false");
      if (s.coral) g.setAttribute("data-coral", "true");
      g.setAttribute("data-active", "false");

      const dot = document.createElementNS(NS, "circle");
      dot.setAttribute("class", "fam-node-dot");
      dot.setAttribute("cx", String(X[i])); dot.setAttribute("cy", String(Y[i])); dot.setAttribute("r", "22");
      g.appendChild(dot);

      const num = document.createElementNS(NS, "text");
      num.setAttribute("class", "fam-node-num");
      num.setAttribute("x", String(X[i])); num.setAttribute("y", String(Y[i] + 5.5));
      num.setAttribute("text-anchor", "middle");
      num.textContent = s.num;
      g.appendChild(num);

      const name = document.createElementNS(NS, "text");
      name.setAttribute("class", "fam-node-name");
      name.setAttribute("x", String(X[i])); name.setAttribute("y", String(Y[i] - 60));
      name.setAttribute("text-anchor", "middle");
      s.line.forEach((ln, k) => {
        const ts = document.createElementNS(NS, "tspan");
        ts.setAttribute("x", String(X[i]));
        ts.setAttribute("dy", k === 0 ? "0" : "17");
        ts.textContent = ln;
        name.appendChild(ts);
      });
      g.appendChild(name);

      nodesG.appendChild(g);
      nodeEls.push(g);

      g.addEventListener("focus", () => select(i));
      g.addEventListener("click", () => select(i));
      g.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); select(i); }
        else if (e.key === "ArrowRight" || e.key === "ArrowDown") { e.preventDefault(); focusNode(i + 1); }
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") { e.preventDefault(); focusNode(i - 1); }
      });
    });

    function focusNode(i: number) {
      i = Math.max(0, Math.min(nodeEls.length - 1, i));
      nodeEls[i].focus();
    }

    const panel = document.getElementById("famPanel");
    const pNum  = document.getElementById("famPanelNum");
    const pName = document.getElementById("famPanelName");
    const pDesc = document.getElementById("famPanelDesc");
    const pPos  = document.getElementById("famPanelPos");
    const prevBtn = document.getElementById("famPrev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("famNext") as HTMLButtonElement | null;

    let current = 0;

    function select(i: number) {
      i = Math.max(0, Math.min(STAGES.length - 1, i));
      current = i;
      const s = STAGES[i];
      svg!.setAttribute("data-selection", "true");
      nodeEls.forEach((n, j) => n.setAttribute("data-active", j === i ? "true" : "false"));
      if (pNum)  pNum.textContent = s.num;
      if (pName) pName.textContent = s.name;
      if (pDesc) pDesc.textContent = s.desc;
      if (pPos)  pPos.textContent = s.num + " / 0" + STAGES.length;
      if (prevBtn) prevBtn.disabled = i === 0;
      if (nextBtn) nextBtn.disabled = i === STAGES.length - 1;
      panel?.setAttribute("data-accent", s.accent ? "true" : "false");
      panel?.setAttribute("data-coral", s.coral ? "true" : "false");
    }

    prevBtn?.addEventListener("click", () => select(current - 1));
    nextBtn?.addEventListener("click", () => select(current + 1));

    // Line-draw animation
    const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function animateLine() {
      const len = climb.getTotalLength();
      climb.style.strokeDasharray = String(len);
      climb.style.strokeDashoffset = String(len);
      (arrow as HTMLElement).style.opacity = "0";
      nodeEls.forEach((n) => ((n as unknown as HTMLElement).style.opacity = "0"));

      const DUR = 1500;
      let start: number | null = null;
      function step(ts: number) {
        if (start === null) start = ts;
        const p = Math.min((ts - start) / DUR, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        climb.style.strokeDashoffset = String(len * (1 - eased));
        nodeEls.forEach((n, j) => {
          if (eased >= (j + 0.5) / nodeEls.length) (n as unknown as HTMLElement).style.opacity = "1";
        });
        if (p >= 1) { (arrow as HTMLElement).style.transition = "opacity 0.3s"; (arrow as HTMLElement).style.opacity = "1"; }
        else requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    // Init
    select(0);
    if (reduce) {
      (arrow as HTMLElement).style.opacity = "1";
      nodeEls.forEach((n) => ((n as unknown as HTMLElement).style.opacity = "1"));
    } else {
      requestAnimationFrame(animateLine);
    }
  }
</script>
