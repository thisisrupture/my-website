  aside.toc a { display:grid; grid-template-columns: 22px 1fr; gap:8px; align-items:baseline; font-family:var(--font-mono); font-size:11px; line-height:1.35; color:var(--fg-muted); padding:8px 0; border-top:var(--hairline-faint); transition: color .25s var(--ease); }
  aside.toc li:first-child a { border-top:0; }
  aside.toc a::before { content: counter(toc, decimal-leading-zero); color:var(--fg-faint); }
  aside.toc a:hover { color:var(--ink); }
  aside.toc a.active { color:var(--ink); }
  aside.toc a.active::before { color:var(--mint-ink); }
  aside.toc a.active span { box-shadow: inset 0 -0.5em 0 var(--mint); }

  main.body { min-width:0; padding: 8px clamp(28px, 5vw, 84px) 72px; }
  .measure { max-width: var(--essay-max); margin: 0 auto; }

  /* hero */
  .hero { display:grid; grid-template-columns: 1fr; gap: 40px; padding: 52px 0 8px; }
  .lede-label { font-family:var(--font-mono); font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:var(--fg-muted); display:flex; align-items:center; gap:10px; margin-bottom:24px; }
  .lede-label .dot { width:7px; height:7px; border-radius:50%; background:var(--coral); display:inline-block; }
  h1.title { font-family:var(--font-serif); font-weight:900; font-size:clamp(2.6rem, 6vw, 4.6rem); line-height:0.98; letter-spacing:-0.02em; margin:0 0 26px; }
  .standfirst { font-family:var(--font-serif); font-weight:400; font-size:clamp(1.25rem,1.9vw,1.55rem); line-height:1.38; margin:0 0 28px; max-width: 42ch; }
  .meta { display:flex; flex-wrap:wrap; gap:16px 28px; font-family:var(--font-mono); font-size:10.5px; letter-spacing:0.1em; text-transform:uppercase; color:var(--fg-muted); border-top:var(--hairline-faint); border-bottom:var(--hairline-faint); padding:16px 0; }
  .meta b { color:var(--ink); font-weight:600; }

  .hero-fig { position: relative; margin: 0; }
  .hero-media { overflow: hidden; aspect-ratio: 16 / 10; background: var(--paper-2); }
  .hero-media img { width:100%; height:100%; object-fit:cover; display:block; }
  .hero-fig figcaption { font-family:var(--font-mono); font-size:10px; letter-spacing:0.08em; text-transform:uppercase; color:var(--fg-muted); padding-top:12px; }

  /* section labels */
  .sec-label { font-family:var(--font-mono); font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:var(--fg-muted); margin: 58px 0 26px; padding-top:22px; border-top:var(--hairline); display:flex; align-items:baseline; gap:12px; }
  .sec-label .n { color:var(--mint-ink); }

  /* prose */
  .body :global(p) { font-size:1.075rem; line-height:1.72; margin:0 0 1.4em; }
  .body :global(p.dropcap:first-letter) { font-family:var(--font-serif); font-weight:900; float:left; font-size:3.6em; line-height:0.74; padding:0.05em 0.12em 0 0; }
  .body :global(.hl) { background:var(--coral); color:var(--ink); padding:0.02em 0.16em; }
  .body :global(p.triad) { font-family:var(--font-serif); font-size:1.35rem; line-height:1.3; margin:0 0 0.5em; }

  /* pull quotes */
  blockquote.pull { margin:52px 0; padding:6px 0 6px 26px; border-left:3px solid var(--mint); font-family:var(--font-serif); font-weight:600; font-size:clamp(1.5rem,2.5vw,2.05rem); line-height:1.2; letter-spacing:-0.01em; }
  blockquote.pull cite { display:block; margin-top:14px; font-family:var(--font-mono); font-style:normal; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--fg-muted); }
  blockquote.kinetic :global(.word) { display:inline-block; }

  /* media */
  figure.media { margin:44px 0; border:var(--hairline); background:var(--paper-2); overflow:hidden; }
  figure.media img { width:100%; display:block; }
  figure.conv-fig .conv-mount { padding:26px 28px 12px; }
  figure.conv-fig svg { width:100%; display:block; }
  figure.conv-fig .dl-label { font-family:var(--font-mono); font-size:9px; letter-spacing:0.18em; fill:var(--mint-ink); }
  figure.media figcaption { font-family:var(--font-mono); font-size:10px; letter-spacing:0.08em; text-transform:uppercase; color:var(--fg-muted); background:var(--paper); border-top:var(--hairline-faint); padding:10px 14px; }

  /* staircase still image */
  figure.stair-img { margin:44px 0; border:var(--hairline); background:var(--paper); padding:24px; }
  figure.stair-img img { width:100%; height:auto; display:block; }
  figure.stair-img figcaption { font-family:var(--font-mono); font-size:10px; letter-spacing:0.08em; text-transform:uppercase; color:var(--fg-muted); padding-top:14px; }

  /* embedded HTML animation */
  figure.embed { margin:44px 0; border:var(--hairline); background:var(--paper); overflow:hidden; }
  figure.embed iframe { width:100%; height:600px; border:0; display:block; background:var(--paper); }
  figure.embed figcaption { font-family:var(--font-mono); font-size:10px; letter-spacing:0.08em; text-transform:uppercase; color:var(--fg-muted); background:var(--paper); border-top:var(--hairline-faint); padding:10px 14px; }
  @media (max-width: 760px) { figure.embed iframe { height:480px; } }

  /* author callout */
  .author { display:flex; gap:26px; align-items:flex-start; margin:64px 0 0; padding-top:34px; border-top:var(--hairline); }
  .author-photo { flex:0 0 auto; }
  .author-photo img { width:108px; height:108px; object-fit:cover; display:block; border:var(--hairline); }
  .author-k { font-family:var(--font-mono); font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--fg-muted); margin-bottom:8px; }
  .author-name { font-family:var(--font-serif); font-weight:700; font-size:1.25rem; line-height:1.1; margin-bottom:10px; }
  .author-copy p { font-size:0.98rem !important; line-height:1.6 !important; color:var(--fg-muted); margin:0 !important; max-width:52ch; }
  @media (max-width: 620px) { .author { gap:18px; } .author-photo img { width:84px; height:84px; } }

  .essay-end { margin:64px 0 0; padding-top:28px; border-top:var(--hairline); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; }
  .essay-end .sig { font-family:var(--font-serif); font-size:1.2rem; font-weight:600; }
  .essay-end a { font-family:var(--font-mono); font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--fg-muted); }

  @media (max-width: 900px) {
    .essay { grid-template-columns: 1fr; }
    aside.toc { display:none; }
    main.body { padding: 8px 22px 52px; }
    .hero { padding-top: 36px; }
  }
</style>

<script>
  // ---- reading progress ----
  const bar = document.getElementById('progress');
  const setProgress = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    if (bar) bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
  };
  document.addEventListener('scroll', setProgress, { passive: true });
  setProgress();

  // ---- contents scrollspy ----
  const links = Array.from(document.querySelectorAll('aside.toc a'));
  const spy = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        const id = '#' + e.target.id;
        links.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === id));
      }
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('section.sec, section.hero').forEach((s) => spy.observe(s));
</script>

<script>
  // convergence figure — the same drawing as the home page, scrubbed to scroll
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { mountFigure } from '../scripts/rupture-figure';
  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mount = document.querySelector('.conv-fig .conv-mount');
  if (mount) {
    const render = mountFigure(mount, 'e');
    if (reduce) {
      render(0.72);                       // converged + coral, static
    } else {
      render(0);
      ScrollTrigger.create({
        trigger: '.conv-fig',
        start: 'top 80%',
        end: 'top 35%',
        scrub: true,
        invalidateOnRefresh: true,
        onUpdate: (self) => render(0.72 * self.progress),  // convergence only, no break
      });
    }
  }
</script>
