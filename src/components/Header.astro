---
const { active = "" } = Astro.props;
---
<header class="site">
  <a href="/#top" class="mark" aria-label="Rupture home">RUPTURE<span class="dot"></span></a>
  <nav class="nav-desktop">
    <a href="/#work" class:list={[{ on: active === "work" }]}>Where we add value</a>
    <a href="/#problem" class:list={[{ on: active === "problem" }]}>The problem</a>
    <a href="/#how" class:list={[{ on: active === "how" }]}>How we work</a>
    <a href="/essay" class:list={[{ on: active === "essay" }]}>The essay</a>
    <a href="/#contact" class="cta">Start with the problem</a>
  </nav>
  <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-mobile">
    <span></span><span></span><span></span>
  </button>
  <nav class="nav-mobile" id="nav-mobile" aria-label="Mobile">
    <a href="/#work" class:list={[{ on: active === "work" }]}>Where we add value</a>
    <a href="/#problem" class:list={[{ on: active === "problem" }]}>The problem</a>
    <a href="/#how" class:list={[{ on: active === "how" }]}>How we work</a>
    <a href="/essay" class:list={[{ on: active === "essay" }]}>The essay</a>
    <a href="/#contact" class="cta">Start with the problem</a>
  </nav>
</header>

<style>
  header.site {
    position: sticky; top: 0; z-index: 40;
    display: flex; align-items: center; justify-content: space-between;
    background: color-mix(in srgb, var(--paper) 97%, transparent);
    border: var(--hairline); padding: 16px 26px;
  }
  .mark { display:flex; align-items:baseline; gap:2px; font-family:var(--font-mono); font-size:15px; letter-spacing:0.14em; font-weight:600; text-transform:uppercase; position:relative; z-index:2; }
  .dot { width:7px; height:7px; border-radius:50%; background:var(--coral); display:inline-block; margin-left:5px; transform:translateY(-1px); transition: transform var(--dur) var(--ease); }
  .mark:hover .dot { transform: translateY(-1px) scale(1.5); }
  nav.nav-desktop { display:flex; align-items:center; gap:26px; font-family:var(--font-mono); font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:var(--fg-muted); }
  nav.nav-desktop a { color:var(--fg-muted); position:relative; transition: color var(--dur) var(--ease); }
  nav.nav-desktop a:not(.cta)::after { content:""; position:absolute; left:0; right:100%; bottom:-5px; height:1.5px; background:var(--ink); transition: right var(--dur) var(--ease); }
  nav.nav-desktop a:not(.cta):hover { color:var(--ink); }
  nav.nav-desktop a:not(.cta):hover::after, nav.nav-desktop a.on::after { right:0; }
  a.cta { border:var(--hairline); border-radius:var(--radius-button); padding:9px 16px; color:var(--ink); letter-spacing:0.1em; background:var(--mint); transition: background var(--dur) var(--ease), transform var(--dur) var(--ease); }
  nav.nav-desktop a.cta:hover { background:var(--accent-press); transform: translateY(-1px); }
  a.cta::after { display:none; }

  /* burger button — hidden on desktop; stays above the overlay when open */
  .burger {
    display:none; flex-direction:column; justify-content:center; gap:5px;
    width:40px; height:40px; padding:9px; margin:-9px -9px -9px 0;
    background:none; border:0; cursor:pointer; position:relative; z-index:2;
  }
  .burger span { display:block; height:1.5px; width:100%; background:var(--ink); border-radius:2px; transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease); }
  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { opacity:0; }
  .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* full-screen mobile overlay */
  .nav-mobile {
    display:none;
    position:fixed; inset:0; z-index:1;
    flex-direction:column;
    padding: calc(env(safe-area-inset-top, 0px) + 88px) 24px calc(env(safe-area-inset-bottom, 0px) + 28px);
    background: var(--paper);
    counter-reset: navi;
    opacity:0; visibility:hidden; transform: translateY(-6px);
    transition: opacity .34s var(--ease), transform .34s var(--ease), visibility .34s var(--ease);
    overflow-y:auto; -webkit-overflow-scrolling:touch;
  }
  .nav-mobile[data-open] { opacity:1; visibility:visible; transform:none; }

  .nav-mobile a {
    font-family:var(--font-mono); text-transform:uppercase; letter-spacing:0.06em;
    font-size: clamp(23px, 6.4vw, 32px); line-height:1.1; color:var(--ink);
    display:flex; align-items:baseline; gap:16px;
    padding:22px 2px; border-bottom:var(--hairline);
    opacity:0; transform: translateY(12px);
    transition: opacity .4s var(--ease), transform .4s var(--ease), color var(--dur) var(--ease);
  }
  .nav-mobile a:not(.cta)::before {
    content: counter(navi, decimal-leading-zero); counter-increment: navi;
    font-size:12px; letter-spacing:0.14em; color:var(--fg-muted); min-width:2.2em;
  }
  .nav-mobile a.on { color:var(--ink); }
  .nav-mobile a:not(.cta).on::before { color:var(--coral); }

  .nav-mobile a.cta {
    margin-top:auto; justify-content:center; text-align:center;
    border:var(--hairline); border-radius:var(--radius-button); background:var(--mint);
    padding:20px; font-size:14px; letter-spacing:0.12em;
  }

  /* staggered reveal on open */
  .nav-mobile[data-open] a { opacity:1; transform:none; }
  .nav-mobile[data-open] a:nth-child(1){ transition-delay:.05s; }
  .nav-mobile[data-open] a:nth-child(2){ transition-delay:.10s; }
  .nav-mobile[data-open] a:nth-child(3){ transition-delay:.15s; }
  .nav-mobile[data-open] a:nth-child(4){ transition-delay:.20s; }
  .nav-mobile[data-open] a:nth-child(5){ transition-delay:.26s; }

  @media (max-width: 820px) {
    header.site { padding: 14px 18px; margin-top: 12px; top: 12px; }
    /* opaque cap over the gap above the sticky bar, so content scrolls out of sight behind it */
    header.site::before {
      content:""; position:fixed; top:0; left:0; right:0;
      height: calc(env(safe-area-inset-top, 0px) + 12px);
      background: var(--paper); z-index:1;
    }
    nav.nav-desktop { display:none; }
    .burger { display:flex; }
    .nav-mobile { display:flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-mobile, .nav-mobile a { transition: opacity .01s linear; transform:none; }
  }
</style>

<script>
  const burger = document.querySelector('.burger') as HTMLButtonElement | null;
  const menu = document.getElementById('nav-mobile');
  if (burger && menu) {
    const lenis = () => (window as any).__lenis;
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) menu.setAttribute('data-open', '');
      else menu.removeAttribute('data-open');
      // lock background scroll while the overlay is open
      if (open) { lenis()?.stop(); document.documentElement.style.overflow = 'hidden'; }
      else { lenis()?.start(); document.documentElement.style.overflow = ''; }
    };
    burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  }
</script>
