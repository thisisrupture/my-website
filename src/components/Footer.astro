<footer class="site">
  <div class="mark">RUPTURE<span class="dot"></span></div>
  <div>This is Rupture Ltd, registered in England and Wales.</div>
  <div class="social"><a href="https://www.linkedin.com/in/kristianwebb/" target="_blank" rel="noopener">LinkedIn ↗</a><a href="https://substack.com/@rupturethinking" target="_blank" rel="noopener">Substack ↗</a></div>
  <div class="tag">Different beats better every time</div>
</footer>

<style>
  .site { display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap; padding:0 8px 40px; font-family:var(--font-mono); font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:var(--fg-muted); }
  .mark { display:flex; align-items:baseline; gap:2px; font-weight:600; color:var(--ink); letter-spacing:0.14em; }
  .dot { width:6px; height:6px; border-radius:50%; background:var(--coral); display:inline-block; margin-left:5px; transform:translateY(-1px); }
  .social { display:flex; gap:20px; }
  .site a { color:var(--fg-muted); transition: color var(--dur) var(--ease); }
  .site a:hover { color:var(--ink); }
  .tag { color:var(--fg-faint); }
</style>
